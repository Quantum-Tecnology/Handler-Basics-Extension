{
  "name": "quantumtecnology/handler-basics-extension",
  "type": "library",
  "license": "MIT",
  "homepage": "http://www.gustavosantarosa.esy.es/",
  "description": "Handler Basics Extension",
  "require": {
    "php": "^8.0",
    "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
  },
  "suggest": {
    "sentry/sentry-laravel": "O BaseHandler reporta as exceções ao Sentry quando ele está instalado."
  },
  "autoload": {
    "psr-4": {
      "QuantumTecnology\\HandlerBasicsExtension\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "QuantumTecnology\\HandlerBasicsExtension\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "authors": [
    {
      "name": "Luis Gustavo Santarosa",
      "email": "gustavo-computacao@hotmail.com",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "gustavo-computacao@hotmail.com"
  },
  "minimum-stability": "stable",
  "extra": {
    "laravel": {
      "providers": [
        "QuantumTecnology\\HandlerBasicsExtension\\Provider\\HandlerBasicsExtensionProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "require-dev": {
    "orchestra/testbench": "^10.7",
    "phpunit/phpunit": "^12.4"
  }
}
